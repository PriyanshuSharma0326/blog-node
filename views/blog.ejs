<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs') %>
    <body>
        <%- include('./partials/navbar.ejs') %>

        <div class="container mt-4">
            <div style="width: 400px; height: 400px; display: flex; align-items: center; justify-content: center;">
                <img 
                    src="/<%= blog.coverImgUrl %>" 
                    alt="<%= blog.title %>"
                    style="max-width: 100%; max-height: 100%; object-fit: contain;"
                >
            </div>

            <div class="card-body mt-4">
                <h1 class="card-title mb-3">
                    <%= blog.title %>
                </h1>
                <div class="text-muted mb-4">
                    Posted on 
                    <%= new Date(blog.createdAt).toDateString() %>
                </div>

                <% if (blog.createdBy) { %>
                    <div class="mb-4">
                        <strong>Author:</strong> <%= blog.createdBy.fullname || 'Unknown' %>
                        <% if (blog.createdBy.email) { %>
                            <div><strong>Email:</strong> <%= blog.createdBy.email %></div>
                        <% } %>
                        <% if (blog.createdBy.role) { %>
                            <div><strong>Role:</strong> <%= blog.createdBy.role %></div>
                        <% } %>
                    </div>
                <% } %>

                <pre class="card-text">
                    <%= blog.body %>
                </pre>
            </div>
        </div>

        <div class="container mt-3 mb-4">
            <% if(comments && comments.length > 0) { %>
                <div class="mt-4">
                    <h5>Comments (<%= comments.length %>)</h5>
                    <% comments.forEach(comment => { %>
                        <div class="mb-2">
                            <div class="py-2">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-semibold"><%= comment.createdBy.fullname %></span>
                                    <small class="text-muted">· <%= new Date(comment.createdAt).toDateString() %></small>
                                </div>
                                <p class="mb-0"><%= comment.content %></p>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="text-muted mt-4">No comments yet. Be the first to comment!</p>
            <% } %>

            <% if(locals.user) { %>
                <form style="width: 50%;" action="/blog/comment/<%= blog._id %>" method="post">
                    <div class="mb-3 d-flex gap-2 align-items-end">
                        <input 
                            type="text"
                            class="form-control flex-grow-1" 
                            name="content" 
                            id="content" 
                            rows="1"
                            placeholder="Enter your comment"
                            style="border: none; border-bottom: 1px solid #dee2e6; border-radius: 0; resize: none; box-shadow: none; outline: none;"
                        />
                        <button class="btn btn-sm btn-primary" type="submit">Add Comment</button>
                    </div>
                </form>
            <% } %>
        </div>

        <%- include('./partials/scripts.ejs') %>
    </body>
</html>
